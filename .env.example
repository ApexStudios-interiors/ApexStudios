# Apex Projects — environment template.
# Copy to .env.local and fill in. NEVER commit real values, here or anywhere.
# Every key below is validated by lib/env.ts at boot; a missing one fails the app.

# ── Runtime ───────────────────────────────────────────────────────────────────
# development | test | production. Next.js sets this; override only in tests.
NODE_ENV=development

# ── Supabase ──────────────────────────────────────────────────────────────────
# Public: safe in the client bundle. RLS is what protects the data, not the key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-anon-key

# Superuser. Bypasses RLS entirely. Server-only, and import-restricted to
# lib/jobs/handlers/** and lib/auth/admin.ts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-service-role-key

# Direct Postgres connection. Migrations and Drizzle only — never a request
# path, because it authenticates as a privileged role and bypasses RLS (D11).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# One private bucket, presigned URLs only. Use the app-scoped token here, not
# the backups token — a compromised app token must not reach apex-backups.
R2_ACCOUNT_ID=replace-with-the-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-the-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-the-r2-secret-access-key
R2_BUCKET=apex-prod

# ── Cron ──────────────────────────────────────────────────────────────────────
# Guards every /api/cron/* route. Generate with: openssl rand -base64 32
CRON_SECRET=replace-with-32-bytes-of-base64-randomness

# ── Observability ─────────────────────────────────────────────────────────────
# Optional. Sentry is disabled in development regardless.
SENTRY_DSN=

# ── CI escape hatch ───────────────────────────────────────────────────────────
# Set to 1 for `next build` in CI, which has no secrets and does not need them
# to compile. Never set this at runtime.
# SKIP_ENV_VALIDATION=1
