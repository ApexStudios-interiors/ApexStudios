# Apex Projects — environment template.
# Copy to .env.local and fill in. NEVER commit real values, here or anywhere.
# Every key below is validated by lib/env.ts at boot; a missing one fails the app.

# ── Runtime ───────────────────────────────────────────────────────────────────
# development | test | production. Next.js sets this; override only in tests.
NODE_ENV=development

# ── Supabase ──────────────────────────────────────────────────────────────────
# Public: safe in the client bundle. RLS is what protects the data, not the key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-anon-key

# The magic-link callback target. Must be allow-listed in Supabase's Redirect
# URLs for every environment (build/03-auth-and-rbac.md §0.1).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Superuser. Bypasses RLS entirely. Server-only, and import-restricted to
# lib/jobs/handlers/** and lib/auth/admin.ts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-service-role-key

# Direct Postgres connection to the hosted project. Migrations, Drizzle and the
# pgTAP suite only — never a request path, because it authenticates as a
# privileged role and bypasses RLS (D11). Settings -> Database -> Connection string.
# D14: there is no local database. This points at apex-dev while developing.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# The production project ref. Nothing here connects to it; it exists so that
# `pnpm db:reset` and `pnpm test:rls` can refuse to run against production.
SUPABASE_PROD_PROJECT_REF=your-prod-project-ref

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# One private bucket, presigned URLs only. Use the app-scoped token here, not
# the backups token — a compromised app token must not reach apex-backups.
R2_ACCOUNT_ID=replace-with-the-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-the-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-the-r2-secret-access-key
R2_BUCKET=apex-prod

# build/06 D17: backup.verify's own check that a real nightly backup object
# exists (a HeadObject, never a write). The GitHub Actions workflow that WRITES
# the backup uses its own, separate, write-scoped token (a repo secret, not this
# file) — see .github/workflows/backup-nightly.yml.
R2_BACKUP_BUCKET=apex-backups

# The read-only credential for that check, and why it is a SEPARATE token
# rather than a permission added to the app one: a Cloudflare R2 token carries
# a single permission level across every bucket it is scoped to. The app
# credential above has to be read-write on R2_BUCKET, so adding apex-backups to
# it would grant write AND delete over the backups to anything holding
# R2_SECRET_ACCESS_KEY — exactly what D17 forbids. Create a second R2 token,
# "Object Read only", scoped to apex-backups alone, and put it here.
#
# Optional. Leave both unset and backup.verify falls back to the app
# credential, behaving as it did before — it just cannot then prove the app is
# unable to write to the backups.
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=

# ── Cron ──────────────────────────────────────────────────────────────────────
# Guards every /api/cron/* route. Generate with: openssl rand -base64 32
CRON_SECRET=replace-with-32-bytes-of-base64-randomness

# Signs the impersonation cookie (D20). Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-32-bytes-of-base64-randomness

# ── Observability ─────────────────────────────────────────────────────────────
# Optional. Sentry is disabled in development regardless.
SENTRY_DSN=

# ── Feature flags ────────────────────────────────────────────────────────────
# build/09-billing.md §4.8. Off in production until a CA has reviewed a
# generated RA bill PDF and signed off in writing (docs/decisions.md).
BILLING_ENABLED=false

# ── CI escape hatch ───────────────────────────────────────────────────────────
# Set to 1 for `next build` in CI, which has no secrets and does not need them
# to compile. Never set this at runtime.
# SKIP_ENV_VALIDATION=1
