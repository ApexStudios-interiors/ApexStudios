# Copy to .env.production.local (gitignored) and fill in from the NEW
# production Supabase project, then run: node scripts/setup-production.mjs
#
# Never put development values here — the script refuses them.

# Project Settings → API (or the Connect panel)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROD-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PROD-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-PROD-SERVICE-ROLE-KEY

# Connect → Session pooler (port 5432), with the database password filled in
DATABASE_URL=postgresql://postgres.YOUR-PROD-REF:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
