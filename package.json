{
  "name": "apex-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rls": "node scripts/run-pgtap.mjs",
    "test:e2e": "playwright test",
    "env:check": "node scripts/check-env.mjs",
    "db:link": "supabase link",
    "db:push": "supabase db push",
    "db:reset": "node scripts/db-reset.mjs",
    "db:migration": "supabase migration new",
    "db:types": "node scripts/gen-types.mjs",
    "db:diff": "supabase db diff --linked",
    "db:config-push": "supabase config push",
    "db:check-drift": "vitest run --config vitest.integration.mts tests/integration/drift.test.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "spike:d15": "node scripts/spike-d15.mjs",
    "test:integration": "vitest run --config vitest.integration.mts",
    "check:release": "node scripts/check-release-ready.mjs",
    "db:inspect": "node scripts/inspect-db.mjs",
    "db:bootstrap": "node scripts/bootstrap.mjs",
    "db:seed": "node scripts/db-seed.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@hookform/resolvers": "^5.9.1",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^10.74.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-table": "^9.2.4",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "next": "16.3.5",
    "next-safe-action": "^8.7.3",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.6",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  }
}
